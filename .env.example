# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=spot-agent-rg
AZURE_LOCATION=eastus
AZURE_STORAGE_ACCOUNT=spotagentstorage
AZURE_STORAGE_CONTAINER=spot-agent-state
AZURE_VM_SIZE=Standard_D2s_v3
AZURE_MAX_SPOT_PRICE=-1

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# MCP Configuration
MCP_SERVERS=[]

# Agent Configuration
AGENT_NAME=spot-agent
AGENT_PLUGINS_DIR=plugins
AGENT_CHECKPOINT_INTERVAL=60
AGENT_MAX_TASK_RETRIES=3
AGENT_LOG_LEVEL=INFO
